<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <Target Name="StopPreviousPostService" BeforeTargets="PrepareForBuild"
          Condition="'$(OS)' == 'Windows_NT' and '$(DesignTimeBuild)' != 'true'">
    <Exec Command="powershell.exe -NoProfile -NonInteractive -Command &quot;$ErrorActionPreference='Stop'; $dll='$(TargetPath)'; $exe=[IO.Path]::ChangeExtension($dll,'.exe'); Get-CimInstance Win32_Process -Filter 'Name=''PostService.exe'' OR Name=''dotnet.exe''' | Where-Object { $_.ExecutablePath -eq $exe -or ($_.Name -eq 'dotnet.exe' -and $_.CommandLine -match [regex]::Escape($dll)) } | ForEach-Object { $p=Get-Process -Id $_.ProcessId -ErrorAction SilentlyContinue; if($p){ Stop-Process -Id $p.Id -Force; $p.WaitForExit(5000) | Out-Null; Write-Host ('Stopped previous PostService PID '+$p.Id) } }&quot;" />
  </Target>
</Project>
