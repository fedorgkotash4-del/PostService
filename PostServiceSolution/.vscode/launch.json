{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "PostService — API",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/PostService/bin/Debug/net10.0/PostService.dll",
      "cwd": "${workspaceFolder}/PostService",
      "args": [
        "--urls",
        "http://localhost:5036"
      ],
      "console": "internalConsole",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "preLaunchTask": "build"
    },
    {
      "name": "PostService — Windows Forms",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/PostService.App/bin/Debug/net10.0-windows/PostService.App.dll",
      "cwd": "${workspaceFolder}/PostService.App",
      "console": "internalConsole",
      "env": {
        "POSTSERVICE_API_URL": "http://localhost:5036/"
      }
    },
    {
      "name": "PostService — API (спільний запуск)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/PostService/bin/Debug/net10.0/PostService.dll",
      "cwd": "${workspaceFolder}/PostService",
      "args": [
        "--urls",
        "http://localhost:5036"
      ],
      "console": "internalConsole",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "PostService — вебклієнт",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/PostService.WebApp/bin/Debug/net10.0/PostService.WebApp.dll",
      "cwd": "${workspaceFolder}/PostService.WebApp",
      "args": [
        "--urls",
        "http://localhost:5080"
      ],
      "console": "internalConsole",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s"
      }
    }
  ],
  "compounds": [
    {
      "name": "PostService — сервер і клієнт",
      "configurations": [
        "PostService — API (спільний запуск)",
        "PostService — Windows Forms"
      ],
      "preLaunchTask": "build",
      "stopAll": true
    },
    {
      "name": "PostService — сервер і вебклієнт",
      "configurations": [
        "PostService — API (спільний запуск)",
        "PostService — вебклієнт"
      ],
      "preLaunchTask": "build",
      "stopAll": true
    }
  ]
}
